#!/bin/sh
# The CI gates: prepare the private environment, then lint, format, strict typing and tests.
set -eu
cd "$(dirname "$0")/.."
ci/abucache-audit
PY="$(python3 ci/ensure_venv.py)"
export PYTHONPATH="src${PYTHONPATH:+:$PYTHONPATH}"
"$PY" -m ruff check src tests ci/ensure_venv.py
"$PY" -m ruff format --check src tests ci/ensure_venv.py
"$PY" -m mypy --strict src
"$PY" -m pytest -q -n auto