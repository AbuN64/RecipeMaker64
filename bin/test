#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
# venv records its absolute creation target; moved checkouts retain stale pip shebangs.
# Check before invoking any environment code, including dependency refreshes.
if [[ ! -x .venv/bin/python || ! -f .venv/pyvenv.cfg || ! -r .venv/pyvenv.cfg ]]; then
    echo "run bin/dev-setup first (missing or unreadable checkout environment)" >&2
    exit 1
fi
venv_command=$(sed -n 's/^command = //p' .venv/pyvenv.cfg) || {
    echo "run bin/dev-setup first (cannot read checkout environment)" >&2
    exit 1
}
# Python writes the target without quoting, including when the checkout contains spaces.
if [[ "$venv_command" != *" -m venv "* || "$venv_command" != *" $(pwd -P)/.venv" ]]; then
    echo "run bin/dev-setup first (environment was created for another checkout or has no command target)" >&2
    exit 1
fi
export PYTHONPATH=src
total_mb=$(awk '/^MemTotal/{print int($2/1024)}' /proc/meminfo)
if [[ -r /sys/fs/cgroup/memory.stat ]]; then
    free_mb=$(( total_mb - $(awk '/^anon /{print int($2/1048576)}' /sys/fs/cgroup/memory.stat) ))
else
    free_mb=$(awk '/^MemAvailable/{print int($2/1024)}' /proc/meminfo)
fi
# Each test process may use at most 4 GB: a runaway test fails with MemoryError instead of exhausting the host.
ulimit -v 4194304
workers=$(( (free_mb - 4096) / 4096 )); cores=$(nproc)
(( workers > cores )) && workers=$cores; [[ -n "${UNBAKE_CORES:-}" ]] && (( workers > UNBAKE_CORES )) && workers=$UNBAKE_CORES; (( workers < 1 )) && workers=1
# The workers come out of the one host core budget (the slots unbake divides), at most the memory allows.
if .venv/bin/python -c 'from abucache.slots import main' 2>/dev/null; then
    exec .venv/bin/python -m abucache.slots --work "$workers" -- .venv/bin/python -m pytest -q -n '{j}' "$@"
fi
exec .venv/bin/python -m pytest -q -n "$workers" "$@"  # an unbake older than the holder
